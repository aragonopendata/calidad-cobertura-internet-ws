<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty name="LOG_LEVEL_ROOT" source="logging.level.root" defaultValue="INFO"/>
    <springProperty name="LOG_LEVEL_APP" source="logging.level.cobertura" defaultValue="INFO"/>

    <appender name="Console"
        class="ch.qos.logback.core.ConsoleAppender">
        <layout class="ch.qos.logback.classic.PatternLayout">
            <Pattern>%d{ISO8601} %-5level [%t] %C{1.}: %msg%n</Pattern>
        </layout>
    </appender>

    <root level="${LOG_LEVEL_ROOT}">
        <appender-ref ref="Console" />
    </root>

    <logger name="cobertura" level="${LOG_LEVEL_APP}" additivity="false">
        <appender-ref ref="Console" />
    </logger>

</configuration>
